# Copia este fichero como .env y rellena tus claves. .env está en .gitignore.
# Proveedor LLM según llm.provider en config.yaml (por defecto "anthropic").
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...          # solo si llm.provider: "openai"
TAVILY_API_KEY=tvly-...
# Opcional: fuerza un modelo concreto (p. ej. claude-sonnet-5-5)
# LLM_MODEL=
